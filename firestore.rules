rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read-only collections ──────────────────────────────────────────
    match /content/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /services/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /works/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /translations/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Slots ─────────────────────────────────────────────────────────────────
    // Anyone can read available slots (client booking wizard).
    // Only authenticated admin can create / update / delete slots.
    match /slots/{slotId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Bookings ──────────────────────────────────────────────────────────────
    // Anyone can CREATE a booking (no auth required for clients).
    // Reading a single booking by cancelToken is handled at app level
    //   (we query by cancelToken, not by bookingId — so no direct doc read
    //    for unauthenticated users).
    // Full read / update / delete — admin only (authenticated).
    match /bookings/{bookingId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
             'slotId', 'date', 'time', 'serviceId', 'serviceName',
             'client', 'status', 'cancelToken', 'createdAt'
           ])
        && request.resource.data.status == 'pending'
        && request.resource.data.client.name is string
        && request.resource.data.client.name.size() > 0
        && request.resource.data.client.phone is string
        && request.resource.data.client.phone.size() > 0;

      // Authenticated admin: full access.
      allow read, update, delete: if request.auth != null;

      // Unauthenticated client can read their own booking by cancelToken
      // (needed by the cancel page query).
      allow read: if resource.data.cancelToken == request.query.filters.cancelToken;
    }
  }
}